{
  "name": "@chr33s/base-wc",
  "version": "1.0.0",
  "description": "Base UI ported to dependency-free, light-DOM web components.",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.stories.ts"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/elements.js",
    "./dist/*.css",
    "./dist/styles/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./styles.css": "./dist/styles.css",
    "./src": "./src/index.ts",
    "./src/elements": "./src/elements.ts",
    "./src/*": "./src/*.ts",
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "storybook dev -p 6006 --no-open",
    "check": "vp check",
    "fix": "vp check --fix",
    "test": "vp test",
    "test:e2e": "playwright test",
    "test:package": "npm run build && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.9",
    "@storybook/web-components-vite": "10.5.9",
    "happy-dom": "20.11.2",
    "lit": "3.3.3",
    "storybook": "10.5.9",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
